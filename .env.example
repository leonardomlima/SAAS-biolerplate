DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/saas_db
REDIS_PASSWORD=your-redis-password-min-16-chars
REDIS_URL=redis://:your-redis-password@redis:6379/0
JWT_SECRET_KEY=your-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ASAAS_API_KEY=your-asaas-api-key
ASAAS_WEBHOOK_SECRET=your-webhook-secret
ASAAS_ENVIRONMENT=sandbox
BREVO_API_KEY=your-brevo-api-key
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1
PROJECT_NAME=SaaS Boilerplate
API_V1_STR=/api/v1
DEBUG=true
SENTRY_DSN=your-sentry-dsn
VITE_API_URL=http://localhost:8000
VITE_SENTRY_DSN=your-sentry-dsn
VITE_APP_NAME=SaaS Boilerplate

# IA e Agentes (OpenRouter)
OPENROUTER_API_KEY=your-openrouter-api-key
AI_DEFAULT_MODEL=openai/gpt-4o-mini
AI_MAX_CONTEXT_MESSAGES=50
AI_SESSION_EXPIRE_HOURS=24
TEXT2SQL_READ_ONLY=true
TEXT2SQL_MAX_RESULTS=100
